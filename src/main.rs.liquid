    loop {
        pwm_led.set_duty_cycle_fraction(100, 100).ok();
        ticker.next().await;
        pwm_led.set_duty_cycle_fraction(66, 100).ok();
        ticker.next().await;
        pwm_led.set_duty_cycle_fraction(33, 100).ok();
        ticker.next().await;
        pwm_led.set_duty_cycle_fraction(0, 100).ok();
        ticker.next().await;
    }
}
{%- when "UART Echo" -%}
//! UART Echo Example
#![no_std]
#![no_main]

mod emb {
    pub use embassy_executor as executor;
}
use embedded_io_async as io_async;

use static_cell::StaticCell;

use esp_backtrace as _;
use esp_hal as esp;

esp_bootloader_esp_idf::esp_app_desc!();

#[esp_rtos::main]
async fn main(_spawner: emb::executor::Spawner) {
    let (uart_tx, uart_rx) = {
        esp_println::logger::init_logger_from_env();
        let p = esp::init(Default::default());
        {% case target -%}
        {%- when "esp32" -%}
        let (pin_uart_tx, pin_uart_rx) = (p.GPIO1, p.GPIO3);
        {%- when "esp32c2" -%}
        let (pin_uart_tx, pin_uart_rx) = (p.GPIO20, p.GPIO19);
        {%- when "esp32c3" -%}
        let (pin_uart_tx, pin_uart_rx) = (p.GPIO21, p.GPIO20);
        {%- when "esp32c5" -%}
        let (pin_uart_tx, pin_uart_rx) = (p.GPIO11, p.GPIO12);
        {%- when "esp32c6" -%}
        let (pin_uart_tx, pin_uart_rx) = (p.GPIO16, p.GPIO17);
        {%- when "esp32c61" -%}
        let (pin_uart_tx, pin_uart_rx) = (p.GPIO11, p.GPIO10);
        {%- when "esp32h2" -%}
        let (pin_uart_tx, pin_uart_rx) = (p.GPIO24, p.GPIO23);
        {%- when "esp32s2" -%}
        let (pin_uart_tx, pin_uart_rx) = (p.GPIO43, p.GPIO44);
        {%- when "esp32s3" -%}
        let (pin_uart_tx, pin_uart_rx) = (p.GPIO43, p.GPIO44);
        {%- endcase %}
        let timg0 = esp::timer::timg::TimerGroup::new(p.TIMG0);
        let software_interrupt_control = esp::interrupt::software::SoftwareInterruptControl::new(p.SW_INTERRUPT);
        esp_rtos::start(timg0.timer0, software_interrupt_control.software_interrupt0);
        //esp_rtos::start(timg0.timer0, p.FROM_CPU_INTR0);
        let uart = {
            const FIFO_FULL_THRESHOLD: u16 = 64;
            let config = esp::uart::Config::default()
                .with_rx(esp::uart::RxConfig::default()
                .with_fifo_full_threshold(FIFO_FULL_THRESHOLD));
            esp::uart::Uart::new(p.UART0, config).unwrap().with_tx(pin_uart_tx).with_rx(pin_uart_rx).into_async()
        };
        let (uart_rx, uart_tx) = uart.split(); // note that the order is rx first, then tx.
        (uart_tx, uart_rx)
    };
    task_echo(uart_tx, uart_rx).await;
}

async fn task_echo(mut writer: impl io_async::Write, mut reader: impl io_async::Read) {
    const BUFSIZE: usize = 16;
    let buf = {
        static STATIC_CELL: StaticCell<[u8; BUFSIZE]> = StaticCell::new();
        STATIC_CELL.init([0u8; BUFSIZE])
    };
    writer.write_all(b"Enter any keystrokes:\r\n").await.ok();
    writer.flush().await.ok();
    loop {
        match reader.read(buf).await {
            Ok(len) => {
                writer.write_all(&buf[..len]).await.ok();
                writer.flush().await.ok();
            }
            Err(_) => {
                writer.write_all(b"error in reading\r\n").await.ok();
                writer.flush().await.ok();
            }
        }
    }
}
{%- when "I2C SSD1306" -%}
//! I2C SSD1306 example using Embassy and async/await.
#![no_std]
#![no_main]

mod emb {
    pub use embassy_executor as executor;
    pub use embassy_embedded_hal::shared_bus;
    pub use embassy_sync as sync;
    pub use embassy_time as time;
}
use embedded_hal_async as hal_async;

use core::fmt::Write as _;
use heapless::String;
use static_cell::StaticCell;

use esp_backtrace as _;
use esp_hal as esp;
use esp_println::println as info;

esp_bootloader_esp_idf::esp_app_desc!();

pub type AsyncMutexCriticalSection<T> =
    emb::sync::mutex::Mutex<emb::sync::blocking_mutex::raw::CriticalSectionRawMutex, T>;

#[esp_rtos::main]
async fn main(_spawner: emb::executor::Spawner) {
    let (i2c_ssd1306,) = {
        let p = esp::init(esp::Config::default());
        let timg0 = esp::timer::timg::TimerGroup::new(p.TIMG0);
        let software_interrupt_control = esp::interrupt::software::SoftwareInterruptControl::new(p.SW_INTERRUPT);
        esp_rtos::start(timg0.timer0, software_interrupt_control.software_interrupt0);
        //esp_rtos::start(timg0.timer0, p.FROM_CPU_INTR0);
        let mutex_i2c0 = {
            {% case target -%}
            {%- when "esp32" -%}
            let (pin_sda, pin_scl) = (p.GPIO21, p.GPIO22);
            {%- when "esp32c2" -%}
            let (pin_sda, pin_scl) = (p.GPIO21, p.GPIO22);  // not checked yet
            {%- when "esp32c3" -%}
            let (pin_sda, pin_scl) = (p.GPIO21, p.GPIO22);  // not checked yet
            {%- when "esp32c5" -%}
            let (pin_sda, pin_scl) = (p.GPIO21, p.GPIO22);  // not checked yet
            {%- when "esp32c6" -%}
            let (pin_sda, pin_scl) = (p.GPIO21, p.GPIO22);  // not checked yet
            {%- when "esp32c61" -%}
            let (pin_sda, pin_scl) = (p.GPIO21, p.GPIO22);  // not checked yet
            {%- when "esp32h2" -%}
            let (pin_sda, pin_scl) = (p.GPIO21, p.GPIO22);  // not checked yet
            {%- when "esp32s2" -%}
            let (pin_sda, pin_scl) = (p.GPIO8, p.GPIO9);    // not checked yet
            {%- when "esp32s3" -%}
            let (pin_sda, pin_scl) = (p.GPIO8, p.GPIO9);    // not checked yet
            {%- endcase %}
            let config = esp::i2c::master::Config::default()
                .with_frequency(esp::time::Rate::from_khz(400));
            let i2c0 = esp::i2c::master::I2c::new(p.I2C0, config).unwrap()
                .with_sda(pin_sda).with_scl(pin_scl).into_async();
            static STATIC_CELL: StaticCell<AsyncMutexCriticalSection<
                esp::i2c::master::I2c<'static, esp::Async>>> = StaticCell::new();
            STATIC_CELL.init(AsyncMutexCriticalSection::new(i2c0))
        };
        let i2c_ssd1306 = emb::shared_bus::asynch::i2c::I2cDevice::new(mutex_i2c0);
        (i2c_ssd1306,)
    };
    let fut_task_display = task_display(i2c_ssd1306);
    fut_task_display.await;
}

async fn task_display(i2c_ssd1306: impl hal_async::i2c::I2c) {
    info!("Starting display task");
    use ssd1306::prelude::*;
    use embedded_graphics as eg;
    use embedded_graphics::prelude::*;
    enum Direction { Inc, Dec }
    impl Direction {
        fn step(&self, value: &mut i32) {
            *value += match self { Self::Inc => 1, Self::Dec => -1 };
        }
    }
    let mut display = {
        let interface = ssd1306::I2CDisplayInterface::new(i2c_ssd1306);
        let size = ssd1306::size::DisplaySize128x64;
        let rotation = ssd1306::rotation::DisplayRotation::Rotate0;
        ssd1306::Ssd1306Async::new(interface, size, rotation).into_buffered_graphics_mode()
    };
    display.init().await.unwrap();
    let text_style = eg::mono_font::MonoTextStyleBuilder::new()
        .font(&eg::mono_font::ascii::FONT_10X20)
        .text_color(eg::pixelcolor::BinaryColor::On)
        .build();
    let mut sbuf: String<16> = String::new();
    let style_dot = eg::primitives::PrimitiveStyleBuilder::new()
        .fill_color(eg::pixelcolor::BinaryColor::On)
        .build();
    let size_display = {
        let (width, height) = display.dimensions();
        Size::new(width as u32, height as u32)
    };
    let size_dot = Size::new(8, 8);
    let mut i_frame = 0;
    let (mut x, mut y) = (size_display.width as i32 / 2, size_display.height as i32 / 2);
    let (mut x_dir, mut y_dir) = (Direction::Inc, Direction::Inc);
    let mut ticker = emb::time::Ticker::every(emb::time::Duration::from_millis(10));
    loop {
        display.clear(eg::pixelcolor::BinaryColor::Off).unwrap();
        sbuf.clear();
        write!(sbuf, "Frame: {}", i_frame).unwrap();
        eg::text::Text::with_baseline(
            sbuf.as_str(), Point::new(0, 0), text_style, eg::text::Baseline::Top
        ).draw(&mut display).unwrap();
        eg::primitives::Rectangle::new(
            Point::new(x, y), size_dot
        ).into_styled(style_dot).draw(&mut display).unwrap();
        i_frame += 1;
        if x >= (size_display.width - size_dot.width) as i32 {
            x_dir = Direction::Dec;
        } else if x <= 0 {
            x_dir = Direction::Inc;
        }
        if y >= (size_display.height - size_dot.height) as i32 {
            y_dir = Direction::Dec;
        } else if y <= 0 {
            y_dir = Direction::Inc;
        }
        x_dir.step(&mut x);
        y_dir.step(&mut y);
        display.flush().await.unwrap();
        ticker.next().await;
    }
}
