//! Blinky example using Embassy and async/await.
#![no_std]
#![no_main]

mod emb {
    pub use embassy_executor as executor;
    pub use embassy_time as time;
}
use embedded_hal_1 as hal;

use esp_backtrace as _;
use esp_hal as esp;
use esp_println::println as info;

esp_bootloader_esp_idf::esp_app_desc!();

#[esp_rtos::main]
async fn main(_spawner: emb::executor::Spawner) {
    let (pin_led,) = {
        let p = esp::init(Default::default());
        {% case target -%}
        {%- when "esp32" -%}
        let pin_led = p.GPIO2;
        {%- when "esp32c2" -%}
        let pin_led = p.GPIO2;
        {%- when "esp32c3" -%}
        let pin_led = p.GPIO2;
        {%- when "esp32c5" -%}
        let pin_led = p.GPIO2;
        {%- when "esp32c6" -%}
        let pin_led = p.GPIO2;
        {%- when "esp32c61" -%}
        let pin_led = p.GPIO2;
        {%- when "esp32h2" -%}
        let pin_led = p.GPIO2;
        {%- when "esp32s2" -%}
        let pin_led = p.GPIO2;
        {%- when "esp32s3" -%}
        let pin_led = p.GPIO2;
        {%- endcase %}
        esp_println::logger::init_logger_from_env();
        let timg0 = esp::timer::timg::TimerGroup::new(p.TIMG0);
        let software_interrupt_control = esp::interrupt::software::SoftwareInterruptControl::new(p.SW_INTERRUPT);
        esp_rtos::start(timg0.timer0, software_interrupt_control.software_interrupt0);
        //esp_rtos::start(timg0.timer0, p.FROM_CPU_INTR0);
        let pin_led = esp::gpio::Output::new(pin_led, esp::gpio::Level::Low, esp::gpio::OutputConfig::default());
        (pin_led,)
    };
    let fut_task_blinky = task_blinky(pin_led);
    fut_task_blinky.await;
}

async fn task_blinky(mut pin_led: impl hal::digital::OutputPin)
{
    info!("Starting task_blinky");
    let mut ticker = emb::time::Ticker::every(emb::time::Duration::from_millis(500));
    loop {
        pin_led.set_high().ok();
        ticker.next().await;
        pin_led.set_low().ok();
        ticker.next().await;
    }
}
{%- when "GPIO In/Out" -%}
//! GPIO In/Out example using Embassy and async/await.
//!
//! ## Pin Assignment
//! | ESP32           | Function |
//! |-----------------|----------|
//! | GPIO16           | Switch to GND  |
#![no_std]
#![no_main]

mod emb {
    pub use embassy_executor as executor;
    pub use embassy_time as time;
}
use embedded_hal_1 as hal;
use embedded_hal_async as hal_async;

use esp_backtrace as _;
use esp_hal as esp;
use esp_println::println as info;

esp_bootloader_esp_idf::esp_app_desc!();

#[esp_rtos::main]
async fn main(_spawner: emb::executor::Spawner) {
    let (pin_sw, pin_led) = {
        let p = esp::init(Default::default());
        {% case target -%}
        {%- when "esp32" -%}
        let (pin_sw, pin_led) = (p.GPIO16, p.GPIO2);
        {%- when "esp32c2" -%}
        let (pin_sw, pin_led) = (p.GPIO16, p.GPIO2);
        {%- when "esp32c3" -%}
        let (pin_sw, pin_led) = (p.GPIO16, p.GPIO2);
        {%- when "esp32c5" -%}
        let (pin_sw, pin_led) = (p.GPIO16, p.GPIO2);
        {%- when "esp32c6" -%}
        let (pin_sw, pin_led) = (p.GPIO16, p.GPIO2);
        {%- when "esp32c61" -%}
        let (pin_sw, pin_led) = (p.GPIO16, p.GPIO2);
        {%- when "esp32h2" -%}
        let (pin_sw, pin_led) = (p.GPIO16, p.GPIO2);
        {%- when "esp32s2" -%}
        let (pin_sw, pin_led) = (p.GPIO16, p.GPIO2);
        {%- when "esp32s3" -%}
        let (pin_sw, pin_led) = (p.GPIO16, p.GPIO2);
        {%- endcase %}
        esp_println::logger::init_logger_from_env();
        let timg0 = esp::timer::timg::TimerGroup::new(p.TIMG0);
        let software_interrupt_control = esp::interrupt::software::SoftwareInterruptControl::new(p.SW_INTERRUPT);
        esp_rtos::start(timg0.timer0, software_interrupt_control.software_interrupt0);
        //esp_rtos::start(timg0.timer0, p.FROM_CPU_INTR0);
        let pin_sw = {
            let config = esp::gpio::InputConfig::default().with_pull(esp::gpio::Pull::Up);
            esp::gpio::Input::new(pin_sw, config)
        };
        let pin_led = {
            esp::gpio::Output::new(pin_led, esp::gpio::Level::Low, esp::gpio::OutputConfig::default())
        };
        (pin_sw, pin_led)
    };
    let fut_task_in_out = task_in_out(pin_sw, pin_led);
    fut_task_in_out.await;
}

async fn task_in_out<InputPin, OutputPin>(mut pin_sw: InputPin, mut pin_led: OutputPin)
where
    InputPin: hal::digital::InputPin + hal_async::digital::Wait,
    OutputPin: hal::digital::OutputPin,
{
    info!("Starting task_in_out");
    loop {
        let is_pushed = pin_sw.is_low().unwrap();
        if is_pushed {
            info!("Button pressed");
            pin_led.set_high().ok();
        } else {
            info!("Button released");
            pin_led.set_low().ok();
        }
        pin_sw.wait_for_any_edge().await.ok();
        emb::time::Timer::after_millis(30).await;    // debounce delay
    }
}
{%- when "LEDC (PWM)" -%}
//! LEDC (PWM) example using Embassy.
#![no_std]
#![no_main]

mod emb {
    pub use embassy_executor as executor;
    pub use embassy_time as time;
}
use embedded_hal_1 as hal;

use static_cell::StaticCell;

use esp_backtrace as _;
use esp_hal as esp;
use esp_println::println as info;

esp_bootloader_esp_idf::esp_app_desc!();

#[esp_rtos::main]
async fn main(_spawner: emb::executor::Spawner) {
    let (pwm_led,) = {
        let p = esp::init(Default::default());
        let timg0 = esp::timer::timg::TimerGroup::new(p.TIMG0);
        let software_interrupt_control = esp::interrupt::software::SoftwareInterruptControl::new(p.SW_INTERRUPT);
        esp_rtos::start(timg0.timer0, software_interrupt_control.software_interrupt0);
        //esp_rtos::start(timg0.timer0, p.FROM_CPU_INTR0);
        let ledc = esp::ledc::Ledc::new(p.LEDC);
        let ledc_timer0 = {
            use esp::ledc::timer::TimerIFace as _;
            static STATIC_CELL: StaticCell<esp::ledc::timer::Timer<'static, esp::ledc::HighSpeed>> = StaticCell::new();
            let timer = STATIC_CELL.init(ledc.timer::<esp::ledc::HighSpeed>(esp::ledc::timer::Number::Timer0));
            timer.configure(esp::ledc::timer::config::Config {
                duty:           esp::ledc::timer::config::Duty::Duty8Bit,
                clock_source:   esp::ledc::timer::HSClockSource::APBClk,
                frequency:      esp::time::Rate::from_hz(1000)}).unwrap();
            timer
        };
        let pwm_led = {
            use esp::ledc::channel::ChannelIFace as _;
            let mut pwm_led = ledc.channel(esp::ledc::channel::Number::Channel0, p.GPIO2);
            pwm_led.configure(esp::ledc::channel::config::Config {
                timer: ledc_timer0, duty_pct: 0, drive_mode: esp::gpio::DriveMode::PushPull}).unwrap();
            pwm_led
        };
        (pwm_led,)
    };
    let fut_task_dim_led = task_dim_led(pwm_led);
    fut_task_dim_led.await;
}

async fn task_dim_led(mut pwm_led: impl hal::pwm::SetDutyCycle)
{
    info!("Starting task_dim_led");
    let mut ticker = emb::time::Ticker::every(emb::time::Duration::from_millis(500));
    loop {
        pwm_led.set_duty_cycle_fraction(100, 100).ok();
        ticker.next().await;
        pwm_led.set_duty_cycle_fraction(66, 100).ok();
        ticker.next().await;
        pwm_led.set_duty_cycle_fraction(33, 100).ok();
        ticker.next().await;
        pwm_led.set_duty_cycle_fraction(0, 100).ok();
        ticker.next().await;
    }
}
{%- when "MCPWM (Motor Control PWM)" -%}
//! MCPWM (Motor Control PWM) example using Embassy.
#![no_std]
#![no_main]

mod emb {
    pub use embassy_executor as executor;
    pub use embassy_time as time;
}
use embedded_hal_1 as hal;

use esp_backtrace as _;
use esp_hal as esp;
use esp_println::println as info;

esp_bootloader_esp_idf::esp_app_desc!();

#[esp_rtos::main]
async fn main(_spawner: emb::executor::Spawner) {
    let (pwm_led,) = {
        let p = esp::init(Default::default());
        let timg0 = esp::timer::timg::TimerGroup::new(p.TIMG0);
        let software_interrupt_control = esp::interrupt::software::SoftwareInterruptControl::new(p.SW_INTERRUPT);
        esp_rtos::start(timg0.timer0, software_interrupt_control.software_interrupt0);
        //esp_rtos::start(timg0.timer0, p.FROM_CPU_INTR0);
        let mcpwm0 = {
            let clock_config = esp::mcpwm::PeripheralClockConfig::with_frequency(esp::time::Rate::from_mhz(160))
                .unwrap();
            let mut mcpwm0 = esp::mcpwm::McPwm::new(p.MCPWM0, clock_config);
            let timer_config = clock_config.timer_clock_with_frequency(
                999, esp::mcpwm::timer::PwmWorkingMode::Increase,
                esp::time::Rate::from_hz(1000)).unwrap();
            mcpwm0.timer0.start(timer_config);
            mcpwm0.operator0.set_timer(&mcpwm0.timer0);
            mcpwm0
        };
        let pwm_led = mcpwm0.operator0.with_pin_a(
            p.GPIO2, esp::mcpwm::operator::PwmPinConfig::UP_ACTIVE_HIGH);
        (pwm_led,)
    };
    let fut_task_dim_led = task_dim_led(pwm_led);
    fut_task_dim_led.await;
}

