[package]
edition      = "2024"
name         = "{{project-name}}"
rust-version = "1.88"
version      = "0.1.0"

[dependencies]
critical-section = { version = "1.2.0" }
heapless = { version = "0.9.3" }
panic-halt = { version = "1.0.0" }
static_cell = { version = "2.1.1" }

embassy-embedded-hal = { version = "0.6.0" }
embassy-executor = { version = "0.10.0" }
embassy-futures = { version = "0.1.2" }
embassy-sync = { version = "0.8" }
embassy-time = { version = "0.5.0" }

embedded-hal-1 = { package = "embedded-hal", version = "1.0.0" }
embedded-hal-async = { version = "1.0.0" }
embedded-io-async = { version = "0.7.0" }

esp-backtrace = { version = "0.19.0", features = ["panic-handler", "println", "{{target}}"] }
esp-bootloader-esp-idf = { version = "0.5.0", features = ["{{target}}"] }
esp-hal = { version = "~1.1.0", features = ["log-04", "unstable", "{{target}}"] }
esp-println = { version = "0.17.0", features = ["log-04", "{{target}}"] }
esp-rtos = { version = "0.3.0", features = ["embassy", "log-04", "{{target}}"] }

{% case template -%}
{% when "Blinky" -%}
{% when "GPIO In/Out" -%}
{% when "UART Echo" -%}
{% when "I2C SSD1306" -%}
ssd1306 = { version = "0.10.0", features = ["async"] }
embedded-graphics = { version = "0.8.2" }

{% when "I2C SSD1306 + DS3231" -%}
ssd1306 = { version = "0.10.0", features = ["async"] }
embedded-graphics = { version = "0.8.2" }
time = { version = "0.3.55", default-features = false } # no_std

{% when "Wi-Fi HTTP Client" -%}
{% endcase -%}

[profile.dev]
opt-level = "s"

[profile.release]
codegen-units = 1     # LLVM can perform better optimizations using a single thread
debug         = 2     # prefer slower builds but better debugging experience
lto           = 'fat'
opt-level     = 's'
