{%- case target -%}
{%- when "esp32" or "esp32s2" or "esp32s3" -%}
[target.xtensa-{{target}}-none-elf]
runner = "espflash flash --monitor --chip {{target}}"

[build]
rustflags = [
  "-C", "link-arg=-nostartfiles",
]
target = "xtensa-{{target}}-none-elf"
{%- when "esp32c2" or "esp32c3" or "esp32c5" or "esp32c6" or "esp32c61" or "esp32h2" -%}
[target.riscv32imc-unknown-none-elf]
runner = "espflash flash --monitor --chip {{target}}"

[build]
rustflags = [
  # Required to obtain backtraces (e.g. when using the "esp-backtrace" crate.)
  # NOTE: May negatively impact performance of produced code
  "-C", "force-frame-pointers",
]
target = "riscv32imc-unknown-none-elf"
{%- when "esp32p4" -%}
{%- when "esp32s31" -%}
{%- endcase %}

[env]

[unstable]
build-std = ["core"]
